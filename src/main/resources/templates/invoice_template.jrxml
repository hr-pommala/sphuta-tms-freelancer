<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="50" bottomMargin="50"
              uuid="d6b7a6d0-0000-0000-0000-000000000001">

    <!-- KEEP your existing parameters (unchanged names) -->
    <parameter name="clientName" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="periodStart" class="java.time.LocalDate"/>
    <parameter name="periodEnd" class="java.time.LocalDate"/>
    <parameter name="totalHours" class="java.math.BigDecimal"/>
    <parameter name="hourlyRate" class="java.math.BigDecimal"/>
    <parameter name="totalAmount" class="java.math.BigDecimal"/>

    <!-- Optional From/Bill-To parameters (safe defaults) -->
    <parameter name="companyName" class="java.lang.String">
        <defaultValueExpression><![CDATA["Tech Solutions Pvt Ltd"]]></defaultValueExpression>
    </parameter>
    <parameter name="companyAddress" class="java.lang.String">
        <defaultValueExpression><![CDATA["1234 Elm Street\n+91-9876543210\nmahebunnisahask252@gmail.com"]]></defaultValueExpression>
    </parameter>
    <parameter name="billToName" class="java.lang.String">
        <defaultValueExpression><![CDATA[$P{clientName}]]></defaultValueExpression>
    </parameter>
    <parameter name="billToAddress" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <!-- Other optional parameters kept -->
    <parameter name="invoiceNo" class="java.lang.String">
        <defaultValueExpression><![CDATA["INV-2025-001"]]></defaultValueExpression>
    </parameter>
    <parameter name="issueDate" class="java.time.LocalDate">
        <defaultValueExpression><![CDATA[java.time.LocalDate.now()]]></defaultValueExpression>
    </parameter>
    <parameter name="dueDate" class="java.time.LocalDate">
        <defaultValueExpression><![CDATA[java.time.LocalDate.now().plusDays(30)]]></defaultValueExpression>
    </parameter>
    <parameter name="subtotal" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[$P{totalAmount} != null ? $P{totalAmount} : new java.math.BigDecimal(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="discount" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="taxRate" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[new java.math.BigDecimal(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="totalTax" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[$P{subtotal}.multiply($P{taxRate}).divide(new java.math.BigDecimal(100))]]></defaultValueExpression>
    </parameter>
    <parameter name="grandTotal" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[$P{subtotal}.subtract($P{discount}).add($P{totalTax})]]></defaultValueExpression>
    </parameter>

    <!-- Fields must match InvoiceLineDto bean -->
    <field name="entryDate" class="java.time.LocalDate"/>
    <field name="description" class="java.lang.String"/>
    <field name="hours" class="java.math.BigDecimal"/>
    <field name="rate" class="java.math.BigDecimal"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="projectName" class="java.lang.String"/>

    <!-- Title (kept layout) -->
    <title>
        <band height="180">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="34" backcolor="#c92d2d" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="4" width="515" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>

            <!-- FROM block (LEFT) -->
            <staticText>
                <reportElement x="0" y="40" width="40" height="12"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[From]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="52" width="240" height="50"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <!-- Use companyName + companyAddress -->
                <textFieldExpression><![CDATA[$P{companyName} + "\n" + $P{companyAddress}]]></textFieldExpression>
            </textField>

            <!-- BILL TO block (RIGHT) -->
            <staticText>
                <reportElement x="360" y="40" width="60" height="12"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Bill To]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="360" y="52" width="155" height="50"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <!-- billToName default is clientName; billToAddress optional -->
                <textFieldExpression><![CDATA[$P{billToName} + ($P{billToAddress} != null && $P{billToAddress}.length() > 0 ? "\n" + $P{billToAddress} : "")]]></textFieldExpression>
            </textField>

            <!-- Reference (left) -->
            <frame>
                <reportElement x="0" y="96" width="260" height="60" backcolor="#f6f6f6" mode="Opaque"/>
                <staticText>
                    <reportElement x="6" y="4" width="70" height="12"/>
                    <textElement><font size="9" isBold="true"/></textElement>
                    <text><![CDATA[Reference]]></text>
                </staticText>
                <staticText>
                    <reportElement x="6" y="20" width="70" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <text><![CDATA[Invoice No.]]></text>
                </staticText>
                <textField>
                    <reportElement x="80" y="20" width="160" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{invoiceNo}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="6" y="34" width="70" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <text><![CDATA[Date]]></text>
                </staticText>
                <textField pattern="yyyy-MM-dd">
                    <reportElement x="80" y="34" width="160" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{issueDate}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="6" y="48" width="70" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <text><![CDATA[Due Date]]></text>
                </staticText>
                <textField pattern="yyyy-MM-dd">
                    <reportElement x="80" y="48" width="160" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{dueDate}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Project Note (right) -->
            <frame>
                <reportElement x="280" y="96" width="235" height="60" backcolor="#f6f6f6" mode="Opaque"/>
                <staticText>
                    <reportElement x="6" y="4" width="70" height="12"/>
                    <textElement><font size="9" isBold="true"/></textElement>
                    <text><![CDATA[Project Note]]></text>
                </staticText>
                <staticText>
                    <reportElement x="6" y="20" width="70" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <text><![CDATA[Project Name]]></text>
                </staticText>
                <textField>
                    <reportElement x="90" y="20" width="130" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{projectName}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="6" y="34" width="70" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <text><![CDATA[Client Name]]></text>
                </staticText>
                <textField>
                    <reportElement x="90" y="34" width="130" height="12"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{clientName}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="25">
            <line><reportElement x="0" y="0" width="515" height="1"/></line>
            <staticText><reportElement x="0" y="4" width="80" height="18"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="85" y="4" width="120" height="18"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Project / Description]]></text></staticText>
            <staticText><reportElement x="210" y="4" width="80" height="18"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Hours]]></text></staticText>
            <staticText><reportElement x="295" y="4" width="80" height="18"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Rate]]></text></staticText>
            <staticText><reportElement x="380" y="4" width="135" height="18"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
            <line><reportElement x="0" y="24" width="515" height="1"/></line>
        </band>
    </columnHeader>

    <!-- Detail: ensure project name, description, hours, rate, amount render -->
    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="80" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{entryDate} != null ? $F{entryDate}.toString() : ""]]></textFieldExpression>
            </textField>

            <!-- Show Project name + description for clarity -->
            <textField>
                <reportElement x="85" y="0" width="120" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[($F{projectName} != null && $F{projectName}.length() > 0 ? $F{projectName} + " - " : "") + ($F{description} != null ? $F{description} : "")]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="210" y="0" width="80" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{hours} != null ? $F{hours} : new java.math.BigDecimal(0)]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="295" y="0" width="80" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{rate} != null ? $F{rate} : $P{hourlyRate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="380" y="0" width="135" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{amount} != null ? $F{amount} : ($F{hours} != null && ($F{rate} != null || $P{hourlyRate} != null) ? ($F{hours}.multiply($F{rate} != null ? $F{rate} : $P{hourlyRate})) : new java.math.BigDecimal(0))]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary: Terms left, Totals right, Thank-you bar (kept) -->
    <summary>
        <band height="170">
            <staticText>
                <reportElement x="0" y="4" width="240" height="14"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Terms]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="20" width="240" height="80"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Payment Method\nSBI\n12345677"]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement x="300" y="20" width="215" height="110" mode="Opaque" backcolor="#ffffff"/>
                <staticText>
                    <reportElement x="6" y="6" width="120" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <text><![CDATA[Subtotal]]></text>
                </staticText>
                <textField pattern="###,##0.00">
                    <reportElement x="135" y="6" width="70" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{subtotal}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="6" y="24" width="120" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <text><![CDATA[Discount]]></text>
                </staticText>
                <textField pattern="###,##0.00">
                    <reportElement x="135" y="24" width="70" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{discount}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="6" y="42" width="120" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <text><![CDATA[Tax Rate]]></text>
                </staticText>
                <textField pattern="###,##0.00'%'">
                    <reportElement x="135" y="42" width="70" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{taxRate}]]></textFieldExpression>
                </textField>

                <staticText>
                    <reportElement x="6" y="60" width="120" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <text><![CDATA[Total Tax]]></text>
                </staticText>
                <textField pattern="###,##0.00">
                    <reportElement x="135" y="60" width="70" height="12"/>
                    <textElement textAlignment="Right"><font size="9"/></textElement>
                    <textFieldExpression><![CDATA[$P{totalTax}]]></textFieldExpression>
                </textField>

                <!-- Total with red background -->
                <rectangle>
                    <reportElement x="6" y="80" width="199" height="24" backcolor="#c92d2d" mode="Opaque"/>
                </rectangle>
                <staticText>
                    <reportElement x="6" y="80" width="120" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                    <text><![CDATA[Total]]></text>
                </staticText>
                <textField pattern="###,##0.00">
                    <reportElement x="135" y="80" width="70" height="24" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{grandTotal}]]></textFieldExpression>
                </textField>
            </frame>

            <rectangle>
                <reportElement x="0" y="135" width="515" height="20" backcolor="#c92d2d" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="135" width="515" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Thank you for your business!]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
